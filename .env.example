# Django Settings
SECRET_KEY=tu-secret-key-aqui-cambiar-en-produccion
DEBUG=False
ALLOWED_HOSTS=.railway.app,iceasuncion.org,www.iceasuncion.org

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-password-de-aplicacion
DEFAULT_FROM_EMAIL=noreply@iceasuncion.org

# Google Cloud Storage (Opcional - para archivos media)
GS_BUCKET_NAME=
GS_PROJECT_ID=
GS_CREDENTIALS_PATH=

# CSRF Trusted Origins (para Railway)
CSRF_TRUSTED_ORIGINS=https://tu-app.railway.app,https://iceasuncion.org,https://www.iceasuncion.org
